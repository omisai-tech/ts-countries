{
  "name": "@omisai/countries",
  "version": "1.2.0",
  "description": "JS/TS package for country data with classes and interfaces",
  "keywords": [
    "bun",
    "countries",
    "country-data",
    "iso-3166",
    "node",
    "typescript"
  ],
  "bugs": "https://github.com/omisai-tech/ts-countries/issues",
  "license": "MIT",
  "repository": "omisai-tech/ts-countries",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compile": "tsx compiler.ts && oxfmt src/models src/index.ts",
    "build": "rolldown --config rolldown.config.ts && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "size": "npm run build && node scripts/measure-size.mjs",
    "dev": "rolldown --config rolldown.config.ts --watch",
    "clean": "rm -rf dist src/models src/index.ts",
    "rebuild": "bun run clean && bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "validate": "bun scripts/validate.mjs",
    "prepublishOnly": "bun run build && bun run test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "csv-parse": "^7.0.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "rolldown": "^1.2.11",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0",
    "yarn": ">=1.22.0"
  }
}
