{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    ".kilo/**",
    ".agents/**",
    ".codex/**",
    ".aws/**",
    "package-lock.json",
    "bun.lock"
  ]
}
